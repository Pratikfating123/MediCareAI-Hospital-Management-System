datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("PATIENT") // ADMIN, DOCTOR, RECEPTIONIST, PATIENT, PHARMACIST, LAB_STAFF
  phone       String?
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient        Patient?
  doctor         Doctor?
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors     Doctor[]
}

model Doctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  doctorCode     String   @unique
  departmentId   String
  specialization String
  qualification  String
  experience     Int      @default(0) // years
  consultationFee Float   @default(500.0)
  licenseNumber  String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department           @relation(fields: [departmentId], references: [id])
  availabilities DoctorAvailability[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labTests       LabTest[]
  labReports     LabReport[]
}

model Patient {
  id                   String   @id @default(uuid())
  userId               String   @unique
  patientCode          String   @unique
  dateOfBirth          String?
  gender               String?  // MALE, FEMALE, OTHER
  bloodGroup           String?  // A+, A-, B+, B-, AB+, AB-, O+, O-
  phone                String?
  address              String?
  emergencyContactName String?
  emergencyContactPhone String?
  allergies            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labTests       LabTest[]
  labReports     LabReport[]
  bills          Bill[]
}

model DoctorAvailability {
  id          String  @id @default(uuid())
  doctorId    String
  dayOfWeek   String  // MONDAY, TUESDAY, etc.
  startTime   String  // e.g. "09:00"
  endTime     String  // e.g. "17:00"
  isAvailable Boolean @default(true)

  doctor      Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String   @id @default(uuid())
  appointmentCode String   @unique
  patientId       String
  doctorId        String
  date            String   // YYYY-MM-DD
  startTime       String   // HH:MM
  endTime         String   // HH:MM
  reason          String?
  status          String   @default("PENDING") // PENDING, APPROVED, COMPLETED, CANCELLED, RESCHEDULED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient        @relation(fields: [patientId], references: [id])
  doctor          Doctor         @relation(fields: [doctorId], references: [id])
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labTests        LabTest[]
}

model MedicalRecord {
  id            String   @id @default(uuid())
  patientId     String
  doctorId      String
  appointmentId String?
  symptoms      String?
  diagnosis     String?
  treatment     String?
  notes         String?
  allergies     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patient      @relation(fields: [patientId], references: [id])
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model Prescription {
  id               String   @id @default(uuid())
  prescriptionCode String   @unique
  patientId        String
  doctorId         String
  appointmentId    String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient          Patient            @relation(fields: [patientId], references: [id])
  doctor           Doctor             @relation(fields: [doctorId], references: [id])
  appointment      Appointment?       @relation(fields: [appointmentId], references: [id])
  items            PrescriptionItem[]
}

model PrescriptionItem {
  id             String @id @default(uuid())
  prescriptionId String
  medicineId     String
  dosage         String // e.g. "500mg"
  frequency      String // e.g. "1-0-1 after meals"
  duration       String // e.g. "5 days"
  instructions   String?
  quantity       Int    @default(1)

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
}

model MedicineCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  medicines   Medicine[]
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  company   String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  medicines Medicine[]
}

model Medicine {
  id           String   @id @default(uuid())
  medicineCode String   @unique
  name         String
  categoryId   String
  supplierId   String?
  description  String?
  price        Float
  stock        Int      @default(0)
  minimumStock Int      @default(10)
  expiryDate   String?  // YYYY-MM-DD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category            MedicineCategory        @relation(fields: [categoryId], references: [id])
  supplier            Supplier?               @relation(fields: [supplierId], references: [id])
  prescriptionItems   PrescriptionItem[]
  transactions        InventoryTransaction[]
}

model InventoryTransaction {
  id         String   @id @default(uuid())
  medicineId String
  type       String   // PURCHASE, SALE, ADJUSTMENT, RETURN
  quantity   Int
  reason     String?
  reference  String?
  createdAt  DateTime @default(now())

  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}

model LabTest {
  id            String    @id @default(uuid())
  testCode      String    @unique
  patientId     String
  doctorId      String
  appointmentId String?
  testName      String
  description   String?
  status        String    @default("REQUESTED") // REQUESTED, IN_PROGRESS, COMPLETED, CANCELLED
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  patient       Patient     @relation(fields: [patientId], references: [id])
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  labReport     LabReport?
}

model LabReport {
  id         String   @id @default(uuid())
  labTestId  String   @unique
  patientId  String
  doctorId   String
  fileUrl    String?
  fileType   String?  // PDF, IMAGE
  notes      String?
  uploadedAt DateTime @default(now())

  labTest    LabTest  @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id])
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
}

model Bill {
  id            String     @id @default(uuid())
  invoiceNumber String     @unique
  patientId     String
  subtotal      Float
  tax           Float      @default(0)
  discount      Float      @default(0)
  total         Float
  status        String     @default("PENDING") // PENDING, PAID, PARTIAL, CANCELLED
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient       Patient    @relation(fields: [patientId], references: [id])
  items         BillItem[]
  payments      Payment[]
}

model BillItem {
  id          String @id @default(uuid())
  billId      String
  description String
  category    String // CONSULTATION, MEDICINE, LABORATORY, ROOM, SURGERY, OTHER
  quantity    Int    @default(1)
  unitPrice   Float
  total       Float

  bill        Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  billId        String
  amount        Float
  method        String   // CASH, UPI, CARD, ONLINE
  status        String   @default("PAID") // PENDING, PAID, FAILED, REFUNDED
  transactionId String?
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, APPOINTMENT, BILL, LAB, PRESCRIPTION, WARNING
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model HospitalSetting {
  id           String   @id @default(uuid())
  hospitalName String   @default("MediCare AI Super Speciality Hospital")
  address      String   @default("123 Healthcare Boulevard, Medical Enclave")
  phone        String   @default("+1 (800) 555-MEDICARE")
  email        String   @default("support@medicare-ai.com")
  website      String   @default("https://medicare-ai.com")
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
